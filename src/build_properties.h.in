#ifndef LG_BUILD_PROPERTIES_H_
#define LG_BUILD_PROPERTIES_H_
/*
Template properties eventually configured by CMake. This template file is substituted at build time.
*/
//Internal data structures limits
#define MAX_LICENSE_LENGTH 256*1024
#define DEFAULT_RSA_KEY_SIZE 2048

//Build locations and parameters
#define PROJECT_INT_VERSION @lccgen_INT_VERSION@
#define PROJECT_VERSION "@CMAKE_PROJECT_VERSION@"
#define PROJECT_BINARY_DIR "@CMAKE_BINARY_DIR@"
#define PROJECT_SRC_DIR "@CMAKE_CURRENT_LIST_DIR@"
//parent dir when it's built as submodule
#define PROJECT_BASE_DIR "@CMAKE_SOURCE_DIR@" 
#define PROJECT_TEST_SRC_DIR "@CMAKE_CURRENT_LIST_DIR@/test"
#define PROJECT_TEST_TEMP_DIR "@CMAKE_BINARY_DIR@/Testing/Temporary"
#define BUILD_TYPE "@CMAKE_BUILD_TYPE@"

#endif
